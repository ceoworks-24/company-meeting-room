rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 예약: 누구나 읽고 쓸 수 있지만, 형식이 맞는 데이터만 저장됩니다.
    match /bookings/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['title','date','start','end','by','byName','seriesId','repeat','createdAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.byName is string
        && request.resource.data.byName.size() > 0
        && request.resource.data.byName.size() <= 30
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.start is int
        && request.resource.data.end is int
        && request.resource.data.start >= 540
        && request.resource.data.end <= 1140
        && request.resource.data.start < request.resource.data.end
        && request.resource.data.start % 30 == 0
        && request.resource.data.end % 30 == 0;
      allow delete: if true;
    }

    // 30분 단위 칸 표시: 같은 시간에 두 사람이 동시에 예약하는 것을 막습니다.
    match /slots/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['bid','date']);
      allow delete: if true;
    }
  }
}
